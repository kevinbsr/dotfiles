#!/bin/bash
# omarchy:summary=Confirm this session came up, disarming the GPU render-mode dead-man switch
#
# Runs once per login from ~/.config/hypr/autostart.lua. The NVIDIA-primary
# block in ~/.config/hypr/envs.lua writes a "pending" marker before it points
# Hyprland at the RTX 3060. If Hyprland dies before this script runs, the marker
# survives and the next login reverts to hybrid by itself -- there is no visible
# TTY on this machine to fix it by hand.
#
# So this must only disarm once the session is genuinely usable: Hyprland
# answering on its socket AND the shell responding, not merely started.
set -uo pipefail
S="$HOME/.local/state/omarchy"
mkdir -p "$S"

ready=0
for _ in $(seq 1 90); do
  if hyprctl -j monitors >/dev/null 2>&1 && \
     OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; then
    ready=1; break
  fi
  sleep 1
done
((ready)) || { echo "session never became ready; leaving the marker armed" >&2; exit 1; }

# Record the PID of THIS Hyprland: the envs.lua block compares it with its own
# ($PPID) to tell a config reload in a live session from a new login.
hypr_pid=$(hyprctl instances -j 2>/dev/null | jq -r --arg s "${HYPRLAND_INSTANCE_SIGNATURE:-}" '.[] | select(.instance==$s) | .pid' | head -1)
[[ -n $hypr_pid ]] || hypr_pid=$(pgrep -xu "$USER" Hyprland | head -1)
[[ -n $hypr_pid ]] && printf '%s\n' "$hypr_pid" >"$S/gpu-render-confirmed"
rm -f "$S/gpu-render-pending"

# Suspend is not safe in NVIDIA-primary mode yet: on 2026-09-14 the machine hung
# on the way into s2idle (last kernel line "Filesystems sync", no suspend exit)
# and needed a hard reset. Until that is understood, every NVIDIA-primary
# session holds a sleep inhibitor, so a suspend request fails with a reason
# instead of freezing the machine. It is PartOf the graphical session and ends
# at logout; hybrid sessions never get it.
if [[ $(head -n1 "$S/gpu-render-active" 2>/dev/null) == nvidia ]]; then
  systemd-run --user --unit=gpu-nvidia-no-sleep --collect --quiet \
    --property=PartOf=graphical-session.target --property=After=graphical-session.target \
    systemd-inhibit --what=sleep --mode=block --who="NVIDIA-primary session" \
    --why="Suspend hung the machine in NVIDIA render mode (2026-09-14); log out to hybrid before sleeping" \
    sleep infinity 2>/dev/null || true
fi

if [[ -f $S/gpu-render-reverted ]]; then
  when=$(cat "$S/gpu-render-reverted")
  notify-send -u critical -i dialog-warning "GPU render mode reverted to hybrid" \
    "The NVIDIA-primary login of $when did not come up, so this session started in hybrid. Check ~/.cache/hyprland/hyprlandCrashReport*.txt before trying again." 2>/dev/null
  rm -f "$S/gpu-render-reverted"
fi
exit 0
