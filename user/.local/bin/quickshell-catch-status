#!/bin/bash
# Is the quickshell catcher still watching, and did it catch anything?
#
# The notification at capture time can be missed, and the watcher exits after
# one capture -- so "no notification" and "no watcher running" look identical
# from the outside. This tells them apart.

SAIDA="$HOME/.local/state/quickshell-catch"

echo "== catcher =="
# Match the script by its own path and exclude this process and its parent.
# A loose pattern matches the shell that is running THIS command -- the command
# line contains the script name -- and reports the watcher as running when it is
# not. The same trap killed an interactive shell twice with pkill -f.
linha=$(ps -eo pid,args --no-headers \
  | awk -v me=$$ -v pai=$PPID '$1!=me && $1!=pai && /[q]uickshell-catch [0-9]+ [0-9]+/ {print; exit}')
if [[ -n $linha ]]; then
  echo "  running: $(awk '{$1=""; print}' <<<"$linha" | sed 's/^ *//')"
  tail -1 "$SAIDA/watcher.log" 2>/dev/null | sed 's/^/  last log: /'
else
  echo "  NOT running."
  if [[ -e $SAIDA/ULTIMA-CAPTURA.txt ]]; then
    echo "  It exits after one capture, and there is one -- so it did its job."
  else
    echo "  No capture either, so it was stopped or never started."
    echo "  Start it with: quickshell-catch"
  fi
fi

echo
echo "== captures =="
shopt -s nullglob
arquivos=("$SAIDA"/burn-*.txt)
if ((${#arquivos[@]} == 0)); then
  echo "  none yet."
else
  for f in "${arquivos[@]}"; do
    printf '  %s  (%s)\n' "$(basename "$f")" "$(date -r "$f" '+%d/%m %H:%M')"
    grep -m1 '^pid ' "$f" | sed 's/^/      /'
    grep -A1 -m1 'rss slope' "$f" | tail -1 | sed 's/^ */      rss: /'
    echo "      suspects among children:"
    sed -n '/## children/,/^$/p' "$f" | grep -vE '^##|^$' \
      | grep -oE '(/home/kevin/\.config/omarchy/plugins/[^/ ]+|https://[^/]+)' \
      | sort -u | sed 's/^/        /' | head -6
  done
  echo
  echo "  Read one in full with:  less $SAIDA/ULTIMA-CAPTURA.txt"
fi

echo
echo "== quickshell right now =="
pid=$(pgrep -x quickshell | head -1)
if [[ -z $pid ]]; then
  echo "  not running."
else
  a=$(awk '{print $14+$15}' "/proc/$pid/stat"); sleep 2
  b=$(awk '{print $14+$15}' "/proc/$pid/stat")
  printf '  pid %s, cpu %s%%, rss %s MB, up %s min\n' \
    "$pid" "$(( (b - a) / 2 ))" \
    "$(awk '/VmRSS/{print int($2/1024)}' "/proc/$pid/status")" \
    "$(ps -o etimes= -p "$pid" | awk '{printf "%.0f", $1/60}')"
fi
