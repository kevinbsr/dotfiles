#!/bin/bash
# Keep Hyprland's own log outside /run, where a forced reboot cannot take it.
#
# WHY THIS EXISTS: Hyprland writes to
# $XDG_RUNTIME_DIR/hypr/<signature>/hyprland.log, which lives on tmpfs. On
# 2026-09-16 the compositor hung after a resume with the dock unplugged (its
# IPC stopped answering at 13:17:51, no crash and no core dump), and the only
# record of what it was doing died with the power-button reboot. Whatever hangs
# it next time, the last lines are now on disk.
#
# Copies the tail of every live instance's log every INTERVAL seconds into
# ~/.local/state/hyprland-logs/<signature>.log, keeping the newest KEEP files.
# A tail rather than the whole file: what matters after a hang is the end, and
# the cap keeps a runaway log from filling the disk.
set -uo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
DEST="${XDG_STATE_HOME:-$HOME/.local/state}/hyprland-logs"
INTERVAL="${HYPRLAND_LOG_KEEPER_INTERVAL:-5}"
TAIL_BYTES="${HYPRLAND_LOG_KEEPER_BYTES:-10485760}" # 10 MiB
KEEP="${HYPRLAND_LOG_KEEPER_KEEP:-6}"

mkdir -p "$DEST" || exit 1

copy_once() {
  local log sig dest
  for log in "$RUNTIME"/hypr/*/hyprland.log; do
    [[ -f $log ]] || continue
    sig=$(basename "$(dirname "$log")")
    dest="$DEST/$sig.log"
    # Unchanged since the last pass: nothing to copy.
    [[ -f $dest && $dest -nt $log ]] && continue
    if tail -c "$TAIL_BYTES" "$log" >"$dest.new" 2>/dev/null; then
      mv -f "$dest.new" "$dest"
    else
      rm -f "$dest.new"
    fi
  done
}

prune() {
  local f count=0
  while read -r f; do
    ((count++))
    ((count > KEEP)) && rm -f "$f"
  done < <(ls -1t "$DEST"/*.log 2>/dev/null)
}

trap 'copy_once; exit 0' TERM INT

while true; do
  copy_once
  prune
  sleep "$INTERVAL"
done
