#!/bin/bash
# Wrapper for /usr/bin/hyprctl that repairs a stale HYPRLAND_INSTANCE_SIGNATURE.
#
# Shells inside the persistent tmux server (tmux.service, see tmux-terminal)
# outlive a logout. After logging back in they still carry the previous
# Hyprland instance's signature, and hyprctl then fails with "Couldn't connect".
# Unsetting it does not help: hyprctl falls back to the first directory in
# $XDG_RUNTIME_DIR/hypr, which is usually a dead instance (six of them there on
# 2026-09-15). So when the signature is missing or dead, use the running one.
# Outside tmux the check is skipped entirely.
if [[ -n ${TMUX:-} ]]; then
  dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr
  alive() {
    local pid
    # Test first: a failed "<file" redirection prints its error even with 2>/dev/null after it.
    [[ -r $dir/$1/hyprland.lock ]] && read -r pid <"$dir/$1/hyprland.lock" &&
      [[ -n $pid && $(cat "/proc/$pid/comm" 2>/dev/null) == Hyprland ]]
  }
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || ! alive "$HYPRLAND_INSTANCE_SIGNATURE"; then
    for sig in $(ls -1t "$dir" 2>/dev/null); do
      alive "$sig" && { export HYPRLAND_INSTANCE_SIGNATURE=$sig; break; }
    done
  fi
fi
exec /usr/bin/hyprctl "$@"
