#!/bin/bash
# Alterna o backlight do teclado do G15, com anti-repique.
#
# POR QUE EXISTE: a tecla de backlight do teclado interno emite KEY_F18 (evdev
# 188 = keycode X11 196) e REPETE enquanto pressionada -- medido em 2026-09-04:
# 19 eventos em 7 s. Sem filtro, cada toque pula varios niveis de uma vez.
# O listener antigo (g15-backlight-key-listener.py) resolvia isso com
# DEBOUNCE_SECONDS = 0.25; aqui a mesma janela, no lado do bind.
set -u

JANELA_MS=250
CARIMBO=/tmp/kbd-backlight-cycle.stamp

agora=$(date +%s%3N)
if [ -f "$CARIMBO" ]; then
  anterior=$(cat "$CARIMBO" 2>/dev/null || echo 0)
  case "$anterior" in ''|*[!0-9]*) anterior=0 ;; esac
  if [ $((agora - anterior)) -lt "$JANELA_MS" ]; then
    exit 0
  fi
fi
echo "$agora" > "$CARIMBO"

exec /home/kevin/.local/bin/omarchy-brightness-keyboard-dell-g15 "${1:-cycle}"
