#!/bin/bash
# Catch quickshell in the act when it pegs a core, and write down what it was
# doing. Intermittent is the whole problem here: on 2026-09-13 the main thread
# sat at 99% for ~15 minutes with RSS climbing 1.2 MB/s, and toggling a plugin
# cleared it -- which means the evidence was gone before the cause was proven.
# Disabling devbook.futbar stopped it, but RE-ENABLING did not bring it back,
# so that plugin is a suspect and nothing more. This exists to settle it.
#
# Captures, at the moment of the burn and not after:
#   - stack samples of the QML thread (where the JS actually is)
#   - child processes (which plugin is fetching or spawning)
#   - RSS slope (a parse loop allocates; a spin loop does not)
#
# Usage: quickshell-catch [cpu_threshold=50] [sustained_seconds=3]
# Writes to ~/.local/state/quickshell-catch/ and exits after one capture.

# Detach into a transient systemd service, as root, on first run.
#
# gdb needs root here: yama ptrace_scope is 1, so it can only attach to its own
# descendants, and quickshell is not one. And the watcher has to outlive the
# terminal it was started from. Three earlier ways of getting both failed:
#   - calling sudo at capture time: the watcher idles for hours, sudo's
#     timestamp expires, and the capture came back with no stacks;
#   - re-exec'ing under plain sudo: it ran in the foreground and died with the
#     terminal;
#   - `sudo setsid -f`: died before writing a single log line. Not confirmed
#     why; sudo's use_pty teardown when setsid's parent exits at once is the
#     likely suspect.
# systemd-run hands the process to PID 1, which owns it from then on: no tty, no
# sudo timestamp, no session to die with. Run plain `quickshell-catch` from any
# terminal; it asks for the password once and returns.
if [[ ${QSCATCH_DETACHED:-} != 1 ]]; then
  alvo=$(readlink -f "$0")
  dono=${SUDO_USER:-$(id -un)}
  casa=$(getent passwd "$dono" | cut -d: -f6)
  prefixo=()
  ((EUID != 0)) && prefixo=(sudo)
  "${prefixo[@]}" systemctl reset-failed quickshell-catch.service 2>/dev/null
  exec "${prefixo[@]}" systemd-run --unit=quickshell-catch --collect --quiet \
    --setenv=QSCATCH_DETACHED=1 --setenv=DONO="$dono" --setenv=CASA="$casa" \
    "$alvo" "$@"
fi

DONO=${DONO:-kevin}
CASA=${CASA:-/home/$DONO}

# 50% for 3 s. The first defaults (80% for 20 s) came from a guess; nineteen
# hours of logging showed real episodes of 1 to 5 seconds, so a 20-second
# window could never fire.
LIMIAR=${1:-50}
SUSTENTADO=${2:-3}
SAIDA="$CASA/.local/state/quickshell-catch"
mkdir -p "$SAIDA"
chown "$DONO" "$SAIDA" 2>/dev/null

# Write each line straight to the log file as well as stdout. Redirecting stdout
# to a file makes it block-buffered, so a watcher that sits idle for hours shows
# an EMPTY log the whole time -- indistinguishable from one that crashed on
# startup. Appending per line reopens the file each time, which flushes.
log() {
  local l
  l="$(date +%H:%M:%S) $1"
  printf '%s\n' "$l"
  printf '%s\n' "$l" >>"$SAIDA/watcher.log"
}

cpu_de() { # $1 = pid, mede 1s
  local a b
  a=$(awk '{print $14+$15}' "/proc/$1/stat" 2>/dev/null) || return 1
  sleep 1
  b=$(awk '{print $14+$15}' "/proc/$1/stat" 2>/dev/null) || return 1
  echo $(( b - a ))
}

log "watching for quickshell above ${LIMIAR}% for ${SUSTENTADO}s"
acima=0

while :; do
  pid=$(pgrep -x quickshell | head -1)
  if [[ -z $pid ]]; then sleep 5; acima=0; continue; fi

  c=$(cpu_de "$pid") || { sleep 5; continue; }
  if ((c >= LIMIAR)); then
    acima=$((acima + 1))
  else
    ((acima > 0)) && log "settled after ${acima}s at ${c}%"
    acima=0
  fi

  if ((acima >= SUSTENTADO)); then
    stamp=$(date +%Y%m%d-%H%M%S)
    f="$SAIDA/burn-$stamp.txt"
    log "CAUGHT IT at ${c}% -- capturing to $f"

    {
      echo "# quickshell burn, $stamp"
      echo "pid $pid, up $(ps -o etimes= -p "$pid" | tr -d ' ')s, cpu ${c}%"
      awk '/VmRSS/{print "rss " $2/1024 " MB"}' "/proc/$pid/status"
      echo

      # STACKS FIRST. The burn can end while the capture is still running, and
      # everything else here is slower than sampling: the first version spent
      # ten seconds measuring the RSS slope before it ever called gdb, and by
      # then the thread was back in ppoll -- twelve samples of an idle event
      # loop, which says nothing about what was spinning.
      echo "## QML thread stacks (12 samples)"
      for i in $(seq 1 12); do
        echo "--- sample $i ---"
        timeout 15 gdb -p "$pid" -batch -ex "thread apply 1 bt 18" 2>/dev/null | grep '^#'
      done
      echo
      echo "## children (who is fetching or spawning)"
      ps --ppid "$pid" -o pid,etimes,stat,args --no-headers 2>/dev/null
      echo
      echo "## unreaped zombies (a plugin spawning without waiting)"
      ps --ppid "$pid" -o stat --no-headers 2>/dev/null | grep -c Z
      echo
      echo "## open connections"
      timeout 20 ss -tnp 2>/dev/null | grep "pid=$pid," | awk '{print "  ", $4, "->", $5}' | sort -u | head -12
      echo
      echo "## still burning after the samples?"
      a=$(awk '{print $14+$15}' "/proc/$pid/stat"); sleep 2
      b=$(awk '{print $14+$15}' "/proc/$pid/stat")
      echo "  cpu now $(( (b - a) / 2 ))%"
      echo
      echo "## rss slope over 10s (allocating = parse loop, flat = spin loop)"
      r0=$(awk '/VmRSS/{print $2}' "/proc/$pid/status"); sleep 10
      r1=$(awk '/VmRSS/{print $2}' "/proc/$pid/status")
      echo "  $((r0/1024)) MB -> $((r1/1024)) MB  ($(( (r1-r0)/1024 )) MB in 10s)"
      echo

      # Ask the SHELL which plugins are on. shell.json's disabledPlugins is not
      # the source of truth -- it disagrees with the running shell, so a capture
      # built from it lists plugins that are actually off and misleads whoever
      # reads it later.
      echo "## enabled plugins (from the shell, not shell.json)"
      sudo -u "$DONO" XDG_RUNTIME_DIR="/run/user/$(id -u "$DONO")" \
        qs -p /usr/share/omarchy/shell ipc call shell listPlugins 2>/dev/null \
        | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: print('  (could not read from the shell)'); raise SystemExit
for p in sorted(d, key=lambda x: x['id']):
    if p['enabled']: print('  ', p['id'], '' if p['firstParty'] else '(third-party)')
" 2>/dev/null
    } >"$f" 2>&1

    chown "$DONO" "$f" 2>/dev/null
    log "done -- $f"

    # Notify AS THE USER, with their session bus handed over explicitly.
    # This runs as root, and root's notify-send cannot reach the user's session:
    # it tries to autolaunch its own bus and fails. It fails quietly, too -- exit
    # status 0 with the error only on stderr -- so the first version would have
    # captured the burn and told nobody, which defeats the point of catching an
    # intermittent fault at all.
    uid=$(id -u "$DONO")
    sudo -u "$DONO" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      XDG_RUNTIME_DIR="/run/user/$uid" \
      notify-send -u critical -i dialog-warning \
        "quickshell burn captured" \
        "$(basename "$f") -- run: quickshell-catch-status" 2>/dev/null

    # A notification can be missed or dismissed. Leave a durable marker too.
    ln -sfn "$f" "$SAIDA/ULTIMA-CAPTURA.txt"
    chown -h "$DONO" "$SAIDA/ULTIMA-CAPTURA.txt" 2>/dev/null
    exit 0
  fi
done
