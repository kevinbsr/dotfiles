#!/bin/bash

# omarchy:summary=Apply the current theme keyboard color to Dell G15 keyboards
# omarchy:hidden=true

DELL_THEME="$HOME/.local/state/omarchy/current/theme/keyboard.rgb"
[[ -f $DELL_THEME ]] || exit 0

hex=$(cat "$DELL_THEME")
hex="${hex#\#}"
[[ ${#hex} -eq 6 ]] || exit 0

python3 - "$hex" << 'PYEOF'
import fcntl, glob, os, sys, time

SEND, RECV = 0xC0224806, 0xC0224807

def find_dev():
    for p in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        ue = os.path.join(os.path.realpath(p), "device", "uevent")
        try:
            d = open(ue).read().upper()
            if "0000187C" in d and "00000550" in d:
                return "/dev/" + os.path.basename(p)
        except Exception:
            pass

def pkt(cmd, args=()):
    b = bytearray(34)
    b[1] = 0x03
    b[2] = cmd
    for i, v in enumerate(args):
        b[3 + i] = v
    return b

def send(f, cmd, args=()):
    fcntl.ioctl(f, SEND, pkt(cmd, args))
    resp = bytearray(34)
    fcntl.ioctl(f, RECV, resp)
    return resp

dev = find_dev()
if not dev:
    sys.exit(0)

hex_color = sys.argv[1]
r = int(hex_color[0:2], 16)
g = int(hex_color[2:4], 16)
b = int(hex_color[4:6], 16)

DURATION = 0x07D0  # 2000 ms
TEMPO    = 0x00FA  # 250

try:
    with open(dev, "r+b", buffering=0) as f:
        # Query zone count from device config report
        resp = send(f, 0x20, [0x02])
        time.sleep(0.06)
        zone_count = resp[6] if 1 <= resp[6] <= 32 else 16

        # Start new animation (running, not saved to flash)
        send(f, 0x21, [0x00, 0x01, 0xFF, 0xFF, 0x00, 0x00])
        time.sleep(0.06)

        for zone in range(zone_count):
            send(f, 0x23, [0x01, 0x00, 0x01, zone])
            time.sleep(0.06)
            send(f, 0x24, [
                0x00,
                DURATION >> 8, DURATION & 0xFF,
                TEMPO >> 8,    TEMPO & 0xFF,
                r, g, b,
            ])
            time.sleep(0.06)

        # Play animation without saving to flash
        send(f, 0x21, [0x00, 0x03, 0xFF, 0xFF, 0x00, 0x00])
        time.sleep(1.0)
except Exception:
    pass
PYEOF
