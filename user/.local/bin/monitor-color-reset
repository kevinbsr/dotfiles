#!/bin/bash
# Restaura a calibracao do ASUS TUF VG34WQML5A por DDC/CI.
#
# POR QUE EXISTE: navegar no OSD do monitor derruba os ajustes. Pior, os
# controles cascateiam entre si -- trocar o modo GameVisual SOBRESCREVE a
# temperatura de cor, e trocar o preset de temperatura mexe no brilho. Por isso
# a ordem abaixo importa e nao pode ser trocada:
#
#   1. Display Mode (DC)      -- primeiro, porque reseta a temperatura
#   2. Preset de cor (14)      -- depois, porque reseta ganhos/brilho
#   3. Ganhos RGB (16/18/1A)   -- por ultimo, e o ajuste fino
#
# ATENCAO -- O CLAMP DE GAMUTE NAO ESTA AQUI. O `Display Color Space` (sRGB /
# DCI-P3 / Wide Gamut) fica em Color no OSD e NAO e exposto por nenhum VCP:
# conferido em `ddcutil capabilities`. Se o monitor for resetado de fabrica,
# esse item volta para o gamute nativo e precisa ser posto em sRGB A MAO, no
# menu. Sem isso, o resto desta calibracao fica sobre uma base errada.
#
# ATUALIZADO 2026-09-04: o Kevin ajustou o monitor manualmente ao gosto dele.
# Os valores abaixo sao os que ELE escolheu, nao os que eu propus -- nao mudar
# sem perguntar. O Display Mode 0x05 e o codigo MCCS; o nome que a ASUS da a
# ele no OSD nao foi conferido, e os nomes do ddcutil nao correspondem aos da
# ASUS (o 0x07, que o ddcutil chama de "Professional", e o FPS Mode).
#
# O contraste em 100 e escolha dele. Registrei a ressalva de que acima de ~75
# o painel tende a cortar altas-luzes; ele optou por manter assim.
#
# Os ganhos vieram de balanco de cinza NO OLHO (2026-09-03), nao de medicao:
# 100/100/100 puxava para amarelo, 95/95/100 puxava para azul, 97/97/100 ficou
# neutro. Isso acerta o cinza medio e mais nada -- nao corrige gama nem o
# balanco nos extremos, e nao gera perfil ICC. Com um colorimetro, refazer.
#
# O lado do PC (240Hz, 10 bpc, cm = srgb) fica em ~/.config/hypr/monitors.lua.
set -u

find_display() {
  ddcutil detect --brief 2>/dev/null \
    | awk '/^Display /{d=$2} /VG34WQML5A/{print d; exit}'
}

D="${1:-$(find_display)}"
if [ -z "${D:-}" ]; then
  echo "monitor-color-reset: ASUS VG34WQML5A nao encontrado por DDC/CI." >&2
  echo "  Confira se esta ligado e se DDC/CI esta ativo no menu do monitor." >&2
  exit 1
fi

fail=0
set_vcp() { # codigo valor descricao
  if ddcutil -d "$D" setvcp "$1" "$2" 2>/dev/null; then
    echo "  ok    $3"
  else
    echo "  FALHA $3" >&2
    fail=1
  fi
  sleep 1
}

echo "ASUS VG34WQML5A (display $D):"
set_vcp DC 0x05 "Display Mode (GameVisual escolhido pelo Kevin)"
set_vcp 14 0x0b "Preset de cor -> User 1"
set_vcp 16 97   "Ganho vermelho -> 97"
set_vcp 18 97   "Ganho verde    -> 97"
set_vcp 1A 100  "Ganho azul     -> 100"
set_vcp 12 100  "Contraste      -> 100"

echo "estado atual:"
for f in DC 14 16 18 1A 10 12; do
  ddcutil -d "$D" getvcp "$f" 2>/dev/null | sed 's/^VCP code /  /'
done

echo
echo "Lembrete: confira no OSD que Color > Display Color Space esta em sRGB."
echo "Esse item nao e ajustavel por DDC."

exit $fail
