#!/usr/bin/env python3
"""Fixed benchmark suite for comparing kernels (or any system change) on this laptop.

    kernel-bench run [--reps N] [--cargo-reps N] [--label TEXT]   measure, on AC
    kernel-bench battery [--minutes N] [--suspend]                measure, on battery
    kernel-bench list                                             saved runs
    kernel-bench compare OLD NEW                                  table with deltas

Results are JSON under ~/.local/state/kernel-bench, one file per run, named by
kernel release and timestamp.

WHY IT ONLY USES WHAT IS INSTALLED: fio, hyperfine and stress-ng would be the
obvious tools, but installing them on the eve of a 31-package upgrade means
pulling dependencies newer than the rest of the system. The equivalents here
are written against the standard library plus 7z, openssl, ffmpeg, sqlite3,
glmark2 and vkmark, which were already present -- and identical tooling before
and after the change is what makes two runs comparable at all.

COMPARABILITY RULES: every run records the power source, the power profile, the
CPU governor, the panel refresh rate and the load average. `compare` refuses to
pretend two runs match when those differ; it prints the mismatch instead.
Results are medians of `--reps` repetitions, so a single thermal excursion does
not decide the outcome. Nothing here pins the CPU or the fan: the point is to
measure the machine as it is actually used.
"""
import argparse
import ctypes
import json
import math
import os
import re
import shutil
import socket
import statistics
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "kernel-bench"
SCRATCH = Path.home() / ".cache/kernel-bench"
BAT = Path("/sys/class/power_supply/BAT1")
AC = Path("/sys/class/power_supply/ACAD/online")
WAYLAND_ENV = {
    "WAYLAND_DISPLAY": os.environ.get("WAYLAND_DISPLAY", "wayland-1"),
    "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
}
NVIDIA_GL = {
    "__NV_PRIME_RENDER_OFFLOAD": "1",
    "__EGL_VENDOR_LIBRARY_FILENAMES": "/usr/share/glvnd/egl_vendor.d/10_nvidia.json",
}
NVIDIA_VK = {"VK_ICD_FILENAMES": "/usr/share/vulkan/icd.d/nvidia_icd.json"}


# --- plumbing ---------------------------------------------------------------

def run(cmd, timeout=600, env=None, cwd=None, check=False):
    full = dict(os.environ)
    full.update(env or {})
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           env=full, cwd=cwd, errors="replace")
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, str(e)
    if check and p.returncode != 0:
        return None, (p.stderr or p.stdout or "").strip()[:200]
    return p.stdout, p.stderr


def read(path, default=None):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def hypr_socket():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    base = Path(WAYLAND_ENV["XDG_RUNTIME_DIR"]) / "hypr"
    if not sig or not (base / sig / ".socket.sock").exists():
        live = [d for d in base.glob("*/.socket.sock")]
        if not live:
            return None
        sig = live[0].parent.name
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
    return str(base / sig / ".socket.sock")


def hypr(request):
    path = hypr_socket()
    if not path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(5)
            s.connect(path)
            s.sendall(request.encode())
            out = b""
            while chunk := s.recv(65536):
                out += chunk
        return out.decode("utf-8", "replace")
    except OSError:
        return None


def battery_watts():
    power = read(BAT / "power_now")
    if power:
        return int(power) / 1e6
    cur, volt = read(BAT / "current_now"), read(BAT / "voltage_now")
    if cur and volt:
        return int(cur) * int(volt) / 1e12
    return None


def stats(values, unit, higher_is_better, extra=None):
    clean = [v for v in values if v is not None and not math.isnan(v)]
    if not clean:
        return {"error": "no samples", "unit": unit, "higher_is_better": higher_is_better}
    out = {
        "median": round(statistics.median(clean), 3),
        "min": round(min(clean), 3),
        "max": round(max(clean), 3),
        "samples": [round(v, 3) for v in clean],
        "unit": unit,
        "higher_is_better": higher_is_better,
    }
    if extra:
        out.update(extra)
    return out


# --- environment ------------------------------------------------------------

def environment():
    monitors = hypr("j/monitors")
    rates = {}
    if monitors:
        try:
            rates = {m["name"]: round(m["refreshRate"], 3) for m in json.loads(monitors)}
        except (ValueError, KeyError, TypeError):
            rates = {}
    pkgs = {}
    out, _ = run(["pacman", "-Q", "linux", "mesa", "nvidia-utils", "nvidia-open-dkms",
                  "systemd", "hyprland"], timeout=30)
    for line in (out or "").splitlines():
        parts = line.split()
        if len(parts) == 2:
            pkgs[parts[0]] = parts[1]
    cpu = ""
    for line in (read("/proc/cpuinfo") or "").splitlines():
        if line.startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break
    profile, _ = run(["powerprofilesctl", "get"], timeout=15)
    governors = {read(p) for p in Path("/sys/devices/system/cpu").glob("cpu*/cpufreq/scaling_governor")}
    return {
        "kernel": os.uname().release,
        "cpu": cpu,
        "cpus": os.cpu_count(),
        "packages": pkgs,
        "power_profile": (profile or "").strip(),
        "governor": sorted(g for g in governors if g),
        "on_ac": read(AC) == "1",
        "battery_percent": read(BAT / "capacity"),
        "refresh_rates": rates,
        "monitors": len(rates),
        "loadavg": os.getloadavg(),
        "uptime_s": round(float((read("/proc/uptime") or "0").split()[0])),
        "amd_panel_power_savings": read("/sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings"),
        "nvidia_runtime": read("/sys/bus/pci/devices/0000:01:00.0/power/runtime_status"),
        "timestamp": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }


# --- CPU --------------------------------------------------------------------

def bench_7z(threads):
    out, _ = run(["7z", "b", "-mmt" + str(threads), "1"], timeout=600)
    total = None
    for line in (out or "").splitlines():
        m = re.match(r"^Tot:\s+\d+\s+\d+\s+(\d+)", line.strip())
        if m:
            total = float(m.group(1))
    return total


def bench_openssl(algo):
    out, _ = run(["openssl", "speed", "-seconds", "2", "-evp", algo], timeout=300)
    last = None
    # openssl labels the row in its own spelling: "AES-256-GCM" for the cipher
    # this is asked for as "aes-256-gcm". Matching literally measured nothing
    # on 2026-09-16 and left the metric empty in the first baseline.
    wanted = algo.lower().replace("-", "")
    for line in (out or "").splitlines():
        if line.strip().lower().replace("-", "").startswith(wanted):
            fields = [f for f in line.split() if f.endswith("k")]
            if fields:
                last = float(fields[-1][:-1]) / 1e6  # GB/s from 1024-byte kB/s
    return last


def bench_ffmpeg():
    started = time.monotonic()
    out, err = run([
        "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
        "-f", "lavfi", "-i", "testsrc2=size=1920x1080:rate=30:duration=10",
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
        "-f", "null", "-",
    ], timeout=900)
    if out is None:
        return None
    return time.monotonic() - started


def bench_pingpong(rounds=20000):
    """Wake-up latency between two processes: the scheduler's core job."""
    a_r, a_w = os.pipe()
    b_r, b_w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(a_w); os.close(b_r)
        try:
            for _ in range(rounds):
                if not os.read(a_r, 1):
                    break
                os.write(b_w, b"x")
        finally:
            os._exit(0)
    os.close(a_r); os.close(b_w)
    samples = []
    for _ in range(rounds):
        t0 = time.perf_counter_ns()
        os.write(a_w, b"x")
        os.read(b_r, 1)
        samples.append((time.perf_counter_ns() - t0) / 1000)  # microseconds
    os.close(a_w); os.close(b_r)
    os.waitpid(pid, 0)
    samples.sort()
    return statistics.median(samples), samples[int(len(samples) * 0.99)]


def bench_spawn(count=1000):
    exe = shutil.which("true") or "/usr/bin/true"
    started = time.monotonic()
    for _ in range(count):
        pid = os.fork()
        if pid == 0:
            try:
                os.close(0); os.close(1); os.close(2)
                os.execv(exe, [exe])
            finally:
                os._exit(127)
        os.waitpid(pid, 0)
    return (time.monotonic() - started) / count * 1000  # ms per spawn


def bench_syscall(count=300000):
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    syscall = libc.syscall
    syscall.restype = ctypes.c_long
    sys_getpid = 39  # x86_64
    started = time.perf_counter_ns()
    for _ in range(count):
        syscall(sys_getpid)
    return (time.perf_counter_ns() - started) / count  # ns per call


# --- memory -----------------------------------------------------------------

def bench_memcpy(mib=256, rounds=15):
    import numpy as np
    src = np.ones(mib * 1024 * 1024, dtype=np.uint8)
    dst = np.empty_like(src)
    np.copyto(dst, src)
    started = time.monotonic()
    for _ in range(rounds):
        np.copyto(dst, src)
    elapsed = time.monotonic() - started
    return mib * rounds / 1024 / elapsed  # GiB/s


def bench_pagefault(mib=2048):
    page = 4096
    started = time.monotonic()
    buf = bytearray(mib * 1024 * 1024)
    for offset in range(0, len(buf), page):
        buf[offset] = 1
    elapsed = time.monotonic() - started
    del buf
    return mib / 1024 / elapsed  # GiB/s of first-touch


# --- disk -------------------------------------------------------------------

def disk_file(mib=1024):
    """An incompressible file: /home is btrfs with zstd, so a file of zeros
    would measure the compressor, not the SSD. The same random buffer repeated
    is enough -- compression works per block, and every block is random."""
    SCRATCH.mkdir(parents=True, exist_ok=True)
    target = SCRATCH / "seq.bin"
    if target.exists() and target.stat().st_size == mib * 1024 * 1024:
        return target
    chunk = os.urandom(16 * 1024 * 1024)
    with open(target, "wb") as f:
        for _ in range(mib // 16):
            f.write(chunk)
        f.flush()
        os.fsync(f.fileno())
    return target


def drop_cache(path):
    """Ask the kernel to forget this file's pages. Without it every read test
    measures the page cache: 3300 MB/s and 3 us random reads, versus 144 us
    once the pages are really gone (measured 2026-09-16)."""
    fd = os.open(path, os.O_RDONLY)
    try:
        os.posix_fadvise(fd, 0, os.fstat(fd).st_size, os.POSIX_FADV_DONTNEED)
    finally:
        os.close(fd)


def bench_disk_write(mib=1024):
    SCRATCH.mkdir(parents=True, exist_ok=True)
    target = SCRATCH / "write.bin"
    chunk = os.urandom(16 * 1024 * 1024)
    started = time.monotonic()
    with open(target, "wb") as f:
        for _ in range(mib // 16):
            f.write(chunk)
        f.flush()
        os.fsync(f.fileno())
    elapsed = time.monotonic() - started
    target.unlink(missing_ok=True)
    return mib * 1024 * 1024 / elapsed / 1e6  # MB/s


def bench_disk_read(mib=1024):
    target = disk_file(mib)
    drop_cache(target)
    started = time.monotonic()
    read_bytes = 0
    with open(target, "rb", buffering=0) as f:
        while block := f.read(1024 * 1024):
            read_bytes += len(block)
    elapsed = time.monotonic() - started
    return read_bytes / elapsed / 1e6  # MB/s


def bench_disk_random(ops=2000, block=4096):
    target = disk_file()
    drop_cache(target)
    size = target.stat().st_size
    rnd = __import__("random").Random(1789)  # fixed seed: same offsets every run
    offsets = [rnd.randrange(size // block) * block for _ in range(ops)]
    import mmap
    aligned = mmap.mmap(-1, block)
    try:
        fd = os.open(target, os.O_RDONLY | os.O_DIRECT)
    except OSError:
        return None, None
    samples = []
    try:
        for offset in offsets:
            t0 = time.perf_counter_ns()
            os.preadv(fd, [aligned], offset)
            samples.append((time.perf_counter_ns() - t0) / 1000)
    finally:
        os.close(fd)
        aligned.close()
    samples.sort()
    return 1e6 / statistics.median(samples), samples[int(len(samples) * 0.99)]


def bench_sqlite(rows=40000):
    import sqlite3
    SCRATCH.mkdir(parents=True, exist_ok=True)
    db = SCRATCH / "bench.sqlite"
    for suffix in ("", "-wal", "-shm"):
        Path(str(db) + suffix).unlink(missing_ok=True)
    con = sqlite3.connect(db)
    con.execute("pragma journal_mode=WAL")
    con.execute("pragma synchronous=FULL")
    con.execute("create table t(id integer primary key, payload text)")
    payload = "x" * 120
    started = time.monotonic()
    for i in range(rows):
        con.execute("insert into t(payload) values (?)", (payload,))
        if i % 500 == 0:
            con.commit()
    con.commit()
    elapsed = time.monotonic() - started
    con.close()
    return rows / elapsed  # rows per second, fsync bound


# --- GPU and compositor -----------------------------------------------------

def bench_glmark(env=None):
    out, _ = run(["glmark2-es2-wayland", "-b", "build:duration=3.0",
                  "-b", "texture:duration=3.0", "-b", "shading:duration=3.0"],
                 timeout=300, env={**WAYLAND_ENV, **(env or {})})
    m = re.search(r"glmark2 Score:\s*(\d+)", out or "")
    return float(m.group(1)) if m else None


def bench_vkmark(env=None):
    out, _ = run(["vkmark", "--winsys", "wayland", "-b", "vertex:duration=3",
                  "-b", "shading:duration=3"],
                 timeout=300, env={**WAYLAND_ENV, **(env or {})})
    m = re.search(r"vkmark Score:\s*(\d+)", out or "")
    return float(m.group(1)) if m else None


def bench_window_open(count=8):
    """Time from exec to the window existing in the compositor."""
    samples = []
    for i in range(count):
        title = f"kernel-bench-{os.getpid()}-{i}"
        t0 = time.monotonic()
        proc = subprocess.Popen(["foot", "--title", title, "--", "sleep", "3"],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                env={**os.environ, **WAYLAND_ENV})
        seen = None
        while time.monotonic() - t0 < 10:
            clients = hypr("j/clients") or ""
            if title in clients:
                seen = (time.monotonic() - t0) * 1000
                break
            time.sleep(0.005)
        samples.append(seen)
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        time.sleep(0.3)
    good = [s for s in samples if s is not None]
    return statistics.median(good) if good else None


def bench_ipc(count=300):
    samples = []
    for _ in range(count):
        t0 = time.perf_counter_ns()
        if hypr("j/monitors") is None:
            return None, None
        samples.append((time.perf_counter_ns() - t0) / 1000)
    samples.sort()
    return statistics.median(samples), samples[int(len(samples) * 0.99)]


# --- heavy real work --------------------------------------------------------

def bench_cargo(reps):
    """A clean release build of a real Rust project: CPU, memory and disk together."""
    src = Path.home() / ".local/src/zapfast-git"
    if not (src / "Cargo.toml").exists():
        return None
    samples = []
    for _ in range(reps):
        run(["cargo", "clean"], cwd=src, timeout=300)
        started = time.monotonic()
        out, err = run(["cargo", "build", "--release", "--frozen"], cwd=src, timeout=3600)
        if out is None:
            return None
        samples.append(time.monotonic() - started)
    return samples


# --- phases -----------------------------------------------------------------

def partial_path(kernel, phase):
    return STATE / f"{kernel}-{phase}.partial.json"


def load_partial(kernel, phase):
    """Results measured before an interruption. Unattended runs are the reason:
    a reboot in the middle used to throw away an hour of measurements, because
    nothing was written until the very end."""
    try:
        return json.loads(partial_path(kernel, phase).read_text())["results"]
    except (OSError, ValueError, KeyError):
        return {}


MAX_LOAD = 0.6


def phase_ac(args):
    env = environment()
    if not env["on_ac"] and not args.force:
        sys.exit("On battery: the AC phase is meant to run plugged in (--force to override).")
    # A busy machine measures the machine's other work. The first run on
    # 7.2.5-4-omarchy started at load 1.28 against 0.26 for the baseline, and
    # every number came out worse -- nothing there was attributable to the
    # kernel. Refusing is what makes the hourly timer wait for a quiet hour
    # instead of burning the measurement.
    if env["loadavg"][0] > MAX_LOAD and not args.force:
        print(f"load is {env['loadavg'][0]:.2f} (limit {MAX_LOAD}): not measuring now")
        return None
    results = load_partial(env["kernel"], "ac") if args.resume else {}
    if results:
        print(f"resuming: {len(results)} measurements already on disk", flush=True)
    reps = args.reps
    STATE.mkdir(parents=True, exist_ok=True)

    def flush():
        partial_path(env["kernel"], "ac").write_text(
            json.dumps({"label": args.label, "phase": "ac", "environment": env,
                        "results": results}, indent=2) + "\n")

    def repeat(name, fn, unit, higher, count=None):
        if name in results:
            return
        print(f"  {name} ...", flush=True)
        values = []
        for _ in range(count or reps):
            values.append(fn())
        results[name] = stats(values, unit, higher)
        flush()

    print("CPU", flush=True)
    repeat("cpu_7z_single", lambda: bench_7z(1), "MIPS", True)
    repeat("cpu_7z_all", lambda: bench_7z(os.cpu_count()), "MIPS", True)
    repeat("cpu_openssl_aes256gcm", lambda: bench_openssl("aes-256-gcm"), "GB/s", True)
    repeat("cpu_openssl_sha256", lambda: bench_openssl("sha256"), "GB/s", True)
    repeat("cpu_ffmpeg_x264_1080p10s", bench_ffmpeg, "s", False)

    print("scheduler and syscalls", flush=True)

    def repeat_pair(name_a, name_b, fn, unit_a, unit_b, higher_a, higher_b):
        if name_a in results and name_b in results:
            return
        print(f"  {name_a} ...", flush=True)
        first, second = [], []
        for _ in range(reps):
            a, b = fn()
            first.append(a)
            second.append(b)
        results[name_a] = stats(first, unit_a, higher_a)
        results[name_b] = stats(second, unit_b, higher_b)
        flush()

    repeat_pair("sched_pingpong_median", "sched_pingpong_p99", bench_pingpong,
                "us", "us", False, False)
    repeat("proc_spawn", bench_spawn, "ms/spawn", False)
    repeat("syscall_getpid", bench_syscall, "ns/call", False)

    print("memory", flush=True)
    repeat("mem_copy", bench_memcpy, "GiB/s", True)
    repeat("mem_first_touch", bench_pagefault, "GiB/s", True)

    print("disk", flush=True)
    repeat("disk_seq_write", bench_disk_write, "MB/s", True)
    repeat("disk_seq_read", bench_disk_read, "MB/s", True)
    repeat_pair("disk_rand4k_iops", "disk_rand4k_p99", bench_disk_random,
                "IOPS", "us", True, False)
    repeat("sqlite_insert_fsync", bench_sqlite, "rows/s", True)

    print("GPU", flush=True)
    repeat("gpu_glmark_igpu", lambda: bench_glmark(), "score", True)
    repeat("gpu_vkmark_igpu", lambda: bench_vkmark(), "score", True)
    if args.nvidia:
        repeat("gpu_glmark_nvidia_offload", lambda: bench_glmark(NVIDIA_GL), "score", True)
        repeat("gpu_vkmark_nvidia_offload", lambda: bench_vkmark(NVIDIA_VK), "score", True)

    print("compositor", flush=True)
    repeat("compositor_window_open", bench_window_open, "ms", False)
    repeat_pair("compositor_ipc_median", "compositor_ipc_p99", bench_ipc,
                "us", "us", False, False)

    if args.cargo_reps and "build_cargo_release" not in results:
        print("cargo release build (slow)", flush=True)
        samples = bench_cargo(args.cargo_reps)
        if samples:
            results["build_cargo_release"] = stats(samples, "s", False)
            flush()

    boot, _ = run(["systemd-analyze", "time"], timeout=60)
    results["boot_time_text"] = {"text": (boot or "").strip(), "note": "recorded, not repeatable"}

    path = save(env, results, args.label, "ac")
    partial_path(env["kernel"], "ac").unlink(missing_ok=True)
    return path


def phase_battery(args):
    env = environment()
    if env["on_ac"] and not args.force:
        sys.exit("Still on AC: unplug the charger for the battery phase (--force to override).")
    results = {}
    print(f"idle drain for {args.minutes} min: leave the machine alone", flush=True)
    samples = []
    deadline = time.monotonic() + args.minutes * 60
    while time.monotonic() < deadline:
        time.sleep(10)
        watts = battery_watts()
        if watts:
            samples.append(watts)
    results["idle_drain"] = stats(samples, "W", False, {"minutes": args.minutes})

    if args.suspend:
        print("suspend cycle", flush=True)
        results["suspend_cycle"] = suspend_cycle(args.suspend_seconds)
    return save(env, results, args.label, "battery")


def suspend_cycle(seconds):
    charge_before = read(BAT / "charge_now") or read(BAT / "energy_now")
    alarm = subprocess.run(["pkexec", "/usr/sbin/rtcwake", "-m", "no", "-s", str(seconds)],
                           capture_output=True, text=True)
    if alarm.returncode != 0:
        return {"error": "could not set the RTC alarm: " + (alarm.stderr or "").strip()[:120]}
    t0 = time.monotonic()
    subprocess.run(["systemctl", "suspend"], capture_output=True, text=True)
    # The clock keeps running while suspended; wake-up is when this loop resumes.
    while time.monotonic() - t0 < seconds + 120:
        time.sleep(1)
        if time.monotonic() - t0 > seconds:
            break
    wall = time.monotonic() - t0
    charge_after = read(BAT / "charge_now") or read(BAT / "energy_now")
    volt = read(BAT / "voltage_now")
    drain = None
    if charge_before and charge_after and volt:
        used = (int(charge_before) - int(charge_after)) / 1e6  # Ah
        drain = used * (int(volt) / 1e6) / (seconds / 3600)  # W
    journal, _ = run(["journalctl", "-b", "-k", "-n", "200", "--no-pager", "-o", "short-precise"],
                     timeout=60)
    entry = exit_ = None
    for line in (journal or "").splitlines():
        if "PM: suspend entry" in line:
            entry = line.split()[2]
        elif "PM: suspend exit" in line:
            exit_ = line.split()[2]
    return {
        "wall_s": round(wall, 2),
        "requested_s": seconds,
        "suspend_power_W": round(drain, 3) if drain else None,
        "kernel_entry": entry,
        "kernel_exit": exit_,
        "resumed": exit_ is not None,
        "unit": "mixed",
    }


def save(env, results, label, phase):
    STATE.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    path = STATE / f"{env['kernel']}-{phase}-{stamp}.json"
    path.write_text(json.dumps({"label": label, "phase": phase, "environment": env,
                                "results": results}, indent=2) + "\n")
    print(f"\nsaved {path}")
    return path


# --- reporting --------------------------------------------------------------

def cmd_list(_args):
    for path in sorted(STATE.glob("*.json")):
        data = json.loads(path.read_text())
        env = data["environment"]
        print(f"{path.name}\n    kernel {env['kernel']}  {env['timestamp']}  "
              f"phase={data['phase']}  label={data.get('label') or '-'}")


def cmd_compare(args):
    old = json.loads(Path(args.old).read_text())
    new = json.loads(Path(args.new).read_text())
    for key in ("power_profile", "on_ac", "governor", "refresh_rates"):
        if old["environment"].get(key) != new["environment"].get(key):
            print(f"! {key} differs: {old['environment'].get(key)} vs {new['environment'].get(key)}"
                  " -- the comparison is not clean")
    # The GPU and compositor tests render through the running compositor, so
    # the number of outputs it drives, and their rates, decide those numbers
    # as much as the kernel does.
    old_load, new_load = old["environment"]["loadavg"][0], new["environment"]["loadavg"][0]
    if abs(old_load - new_load) > 0.5:
        print(f"! load average differs: {old_load:.2f} vs {new_load:.2f}"
              " -- slower numbers on the busier run mean nothing")
    print(f"\n{'metric':34} {'old':>12} {'new':>12} {'change':>10}   kernel "
          f"{old['environment']['kernel']} -> {new['environment']['kernel']}")
    print("-" * 78)
    for name, a in old["results"].items():
        b = new["results"].get(name)
        if not isinstance(a, dict) or not isinstance(b, dict) or "median" not in a or "median" not in b:
            continue
        delta = (b["median"] - a["median"]) / a["median"] * 100 if a["median"] else 0
        better = delta > 0 if a.get("higher_is_better") else delta < 0
        mark = "+" if better else ("-" if abs(delta) >= 2 else " ")
        print(f"{name:34} {a['median']:>12.2f} {b['median']:>12.2f} {delta:>9.1f}% {mark} "
              f"{a.get('unit','')}")


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("run", help="AC phase: CPU, memory, disk, GPU, compositor")
    p.add_argument("--reps", type=int, default=3)
    p.add_argument("--cargo-reps", type=int, default=2)
    p.add_argument("--label", default="")
    p.add_argument("--no-nvidia", dest="nvidia", action="store_false")
    p.add_argument("--resume", action="store_true",
                   help="keep measurements already on disk for this kernel and phase")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=phase_ac, nvidia=True)

    p = sub.add_parser("battery", help="battery phase: idle drain and suspend")
    p.add_argument("--minutes", type=int, default=10)
    p.add_argument("--suspend", action="store_true")
    p.add_argument("--suspend-seconds", type=int, default=90)
    p.add_argument("--label", default="")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=phase_battery)

    p = sub.add_parser("list", help="saved runs")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("compare", help="table with deltas between two runs")
    p.add_argument("old")
    p.add_argument("new")
    p.set_defaults(func=cmd_compare)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
