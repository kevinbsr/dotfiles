# Stable, colon-free names for the two GPUs' DRM card nodes:
#   /dev/dri/gpu-amd     the Radeon iGPU  (drives eDP-1)
#   /dev/dri/gpu-nvidia  the RTX 3060     (drives HDMI-A-1 and DP-1)
#
# Hyprland's AQ_DRM_DEVICES needs a device list, and neither obvious name works:
# - /dev/dri/by-path/pci-0000:01:00.0-card contains colons, and Aquamarine
#   splits the list on ":" -- that shredded the paths and caused the login loop
#   of 2026-08-09;
# - /dev/dri/cardN is colon-free, but N is not stable across boots.
# Matching on the driver gives both properties. DEVTYPE drm_minor keeps
# connector devices (card0-DP-1, DEVTYPE drm_connector) out of it.
#
# Used by the NVIDIA-primary render mode in ~/.config/hypr/envs.lua
# (generated by omarchy-gpu-env-sync). Reload: sudo udevadm trigger -c add -s drm && sudo udevadm settle
# (trigger returns before the events are processed; without settle an immediate
# `ls /dev/dri/gpu-*` finds nothing even though the rule worked).
#
# ONLY THE GPU'S OWN NODE. DRIVERS matches the driver of ANY ancestor, and the
# boot framebuffer (simpledrm) is a child of the GPU's PCI device:
#   /devices/.../0000:01:00.0/simple-framebuffer.0/drm/card0
# In hybrid mode amdgpu evicts simpledrm at boot, so this never mattered. With
# hybrid graphics off in the BIOS nothing evicts it (nvidia_drm fbdev=0), both
# card0 (simpledrm) and card1 (nvidia-drm) matched, and gpu-nvidia pointed at
# whichever node udev processed last. On 2026-09-14 a logout re-ran the rules
# (logind ACL change events), the link moved to simpledrm, the SDDM greeter --
# pinned to /dev/dri/gpu-nvidia -- came up on the dead framebuffer alone, and the
# machine sat on a black screen until a hard reset.
# ID_PATH (from 60-drm.rules) is "pci-0000:01:00.0" for the GPU's node and
# "pci-0000:01:00.0-platform-simple-framebuffer.0" for simpledrm, so excluding
# "*-platform-*" keeps exactly the GPU node; link_priority breaks any remaining
# tie in favour of it.
SUBSYSTEM=="drm", ENV{DEVTYPE}=="drm_minor", KERNEL=="card*", DRIVERS=="amdgpu", ENV{ID_PATH}!="*-platform-*", SYMLINK+="dri/gpu-amd", OPTIONS+="link_priority=10"
SUBSYSTEM=="drm", ENV{DEVTYPE}=="drm_minor", KERNEL=="card*", DRIVERS=="nvidia", ENV{ID_PATH}!="*-platform-*", SYMLINK+="dri/gpu-nvidia", OPTIONS+="link_priority=10"
