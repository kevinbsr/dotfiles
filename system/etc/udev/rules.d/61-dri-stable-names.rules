# Stable, colon-free names for the two GPUs' DRM card nodes:
#   /dev/dri/gpu-amd     the Radeon iGPU  (drives eDP-1)
#   /dev/dri/gpu-nvidia  the RTX 3060     (drives HDMI-A-1 and DP-1)
#
# Hyprland's AQ_DRM_DEVICES needs a device list, and neither obvious name works:
# - /dev/dri/by-path/pci-0000:01:00.0-card contains colons, and Aquamarine
#   splits the list on ":" -- that shredded the paths and caused the login loop
#   of 2026-08-09;
# - /dev/dri/cardN is colon-free, but N is not stable across boots.
# Matching on the driver gives both properties. DEVTYPE drm_minor keeps
# connector devices (card0-DP-1, DEVTYPE drm_connector) out of it.
#
# Used by the NVIDIA-primary render mode in ~/.config/hypr/envs.lua
# (generated by omarchy-gpu-env-sync). Reload: sudo udevadm trigger -c add -s drm && sudo udevadm settle
# (trigger returns before the events are processed; without settle an immediate
# `ls /dev/dri/gpu-*` finds nothing even though the rule worked).
SUBSYSTEM=="drm", ENV{DEVTYPE}=="drm_minor", KERNEL=="card*", DRIVERS=="amdgpu", SYMLINK+="dri/gpu-amd"
SUBSYSTEM=="drm", ENV{DEVTYPE}=="drm_minor", KERNEL=="card*", DRIVERS=="nvidia", SYMLINK+="dri/gpu-nvidia"
