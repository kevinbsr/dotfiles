# aquamarine is a local rebuild: 0.15.0 + hyprwm/aquamarine PR #395
# plus the hyprwm/aquamarine#383 exit-crash fix (~/.local/src/aquamarine-pr395, pkgrel 2.2). Without that patch an unplugged
# monitor's CRTC stays active (issue #386) and the NVIDIA card never sleeps after
# undocking. Any repo upgrade replaces the rebuild silently, so say so loudly.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = aquamarine

[Action]
Description = Checking whether the patched aquamarine rebuild (PR #395) was replaced...
When = PostTransaction
Exec = /bin/sh -c 'v=$(pacman -Q aquamarine | cut -d" " -f2); case "$v" in *-2.2) echo "aquamarine $v: local rebuild (PR #395 + #383 fix) in place." ;; *) echo "WARNING: aquamarine $v replaced the local PR #395 rebuild. If hyprwm/aquamarine#386 and #383 are not fixed in it, unplugging monitors leaves the NVIDIA card awake again and Hyprland segfaults on every logout; rebuild from ~/.local/src/aquamarine-pr395 or use Hardware > Undock." ;; esac'
