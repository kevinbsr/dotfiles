# aquamarine is a local rebuild: 0.15.0 + hyprwm/aquamarine PR #395
# (~/.local/src/aquamarine-pr395, pkgrel 2.1). Without that patch an unplugged
# monitor's CRTC stays active (issue #386) and the NVIDIA card never sleeps after
# undocking. Any repo upgrade replaces the rebuild silently, so say so loudly.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = aquamarine

[Action]
Description = Checking whether the patched aquamarine rebuild (PR #395) was replaced...
When = PostTransaction
Exec = /bin/sh -c 'v=$(pacman -Q aquamarine | cut -d" " -f2); case "$v" in *-2.1) echo "aquamarine $v: local PR #395 rebuild in place." ;; *) echo "WARNING: aquamarine $v replaced the local PR #395 rebuild. If hyprwm/aquamarine#386 is not fixed in it, unplugging monitors leaves the NVIDIA card awake again; rebuild from ~/.local/src/aquamarine-pr395 or use Hardware > Undock." ;; esac'
