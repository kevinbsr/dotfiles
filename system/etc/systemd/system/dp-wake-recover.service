[Unit]
Description=Bring the DisplayPort link back after a resume
After=suspend.target
After=hybrid-sleep.target

# This is a SYSTEM unit on purpose. The user manager has no suspend.target, so
# a ~/.config/systemd/user unit wired to it never fires -- which is exactly how
# the first version of this failed silently through several real suspends.
# ryzenadj-resume.service works for the same reason: it lives here.

[Service]
Type=oneshot
User=kevin
Environment=XDG_RUNTIME_DIR=/run/user/1000

# No ExecStartPre=/bin/sleep here on purpose. There used to be one, 8 seconds,
# to give Hyprland time to have its outputs back before a modeset landed. It was
# paid on every single resume -- including the overwhelming majority where the
# link came back fine and the script had nothing to do -- and it was a guess
# either way: 8 s was neither proof the compositor was ready nor proof it was
# not. The script now polls for the conditions it actually needs (the connector
# reading "connected", hyprctl answering with DP-1 and DPMS on), each with its
# own deadline, and the healthy path finishes in well under a second.
ExecStart=/home/kevin/.local/bin/dp-wake-recover

# Nothing inside the script waits without a deadline, but a hung ddcutil on a
# wedged i2c bus should not leave a unit running forever.
TimeoutStartSec=90

[Install]
WantedBy=suspend.target
WantedBy=hybrid-sleep.target
