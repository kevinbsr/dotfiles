#!/bin/bash
# Reapply local patches to the installed omarchy after the package is upgraded.
#
# WHY THIS EXISTS: omarchy-dev tracks the quattro branch, so every upgrade
# overwrites the installed tree wholesale. A patch still waiting on an upstream
# review disappears with it -- silently. The menu multi-select vanished on
# 2026-09-11 and nothing reported it; the feature was simply gone.
#
# This is a stopgap for patches that have an open pull request. Once the PR is
# merged the patch stops applying, this script says so and leaves the files
# alone, and the .patch can be deleted.
#
# Driven by /etc/pacman.d/hooks/95-omarchy-reapply-patches.hook.
#
# PATHS ARE ABSOLUTE, ROOTED AT /, ON PURPOSE. The obvious target would be
# /usr/share/omarchy, but the executables there are symlinks into /usr/bin, and
# the menu invokes them through PATH -- so patching that directory changes
# nothing that runs. `patch --follow-symlinks` is worse than useless here: it
# replaces the symlink with a regular file and leaves the real binary untouched.
# So each patch carries its own real path (usr/bin/..., usr/share/omarchy/...)
# and is applied from /.

set -uo pipefail

PATCH_DIR=/usr/local/share/omarchy-patches
ROOT=/

log() { printf 'omarchy-reapply-patches: %s\n' "$1"; }

# Patches that did not land this run. The log lines alone were not enough:
# after omarchy 4.0.6 -> 4.5.0 (2026-11-05) seven of nine patches stopped
# applying and the warnings sat unread in the pacman output for ten days.
broken=()

# One critical desktop notification per open graphical session. This runs as
# root inside a pacman transaction, with no session bus of its own, so it
# reaches each logged-in user's bus as that user. Run by hand as a normal user,
# it notifies that user directly.
notify_broken() {
  ((${#broken[@]})) || return 0
  local title="Omarchy: ${#broken[@]} local patch(es) no longer apply"
  local body
  body="$(printf '%s\n' "${broken[@]}")
Check with: pkexec /usr/local/bin/omarchy-reapply-patches
Patches live in $PATCH_DIR"

  if ((EUID != 0)); then
    timeout 5 notify-send -a "Omarchy patches" -u critical "$title" "$body" 2>/dev/null || true
    return 0
  fi

  local bus uid user
  for bus in /run/user/*/bus; do
    [[ -S $bus ]] || continue
    uid=$(basename "$(dirname "$bus")")
    ((uid >= 1000)) || continue
    user=$(id -nu "$uid" 2>/dev/null) || continue
    timeout 5 runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      notify-send -a "Omarchy patches" -u critical "$title" "$body" 2>/dev/null || true
  done
}

[[ -d $PATCH_DIR ]] || exit 0

shopt -s nullglob
patches=("$PATCH_DIR"/*.patch)
((${#patches[@]})) || exit 0

for p in "${patches[@]}"; do
  name=$(basename "$p" .patch)

  # "Already applied" is asked first. Asking "does it apply forward?" first is
  # not enough: when the patch's context also matches a second, untouched block
  # -- as the horizontal and vertical bar centers did in omarchy 4.0.5 -- the
  # forward check passes on an applied tree and the hunk lands a second time
  # (2026-10-19).
  if patch -p1 -d "$ROOT" --reverse --dry-run --silent <"$p" >/dev/null 2>&1; then
    log "$name: already applied"
    continue
  fi

  # The dry run keeps a patch that no longer fits from leaving half-written
  # files behind: this runs unattended inside a pacman transaction, where a
  # half-patched menu is a broken desktop.
  if ! patch -p1 -d "$ROOT" --forward --dry-run --silent <"$p" >/dev/null 2>&1; then
    log "$name: DOES NOT APPLY -- upstream moved, or the PR was merged."
    log "$name: check it, then delete $p once it is no longer needed."
    broken+=("$name: does not apply")
    continue
  fi

  # No .orig beside the patched file: one landing at an offset left
  # Bar.qml.orig in the shell tree.
  if patch -p1 -d "$ROOT" --forward --silent --no-backup-if-mismatch <"$p" >/dev/null 2>&1; then
    log "$name: reapplied"
  else
    log "$name: FAILED after a clean dry run -- the tree may be inconsistent"
    broken+=("$name: FAILED, tree may be inconsistent")
  fi
done

notify_broken
