#!/bin/bash
# Run the kernel-bench suite unattended, then a real suspend cycle.
#
# WHY A ROOT SERVICE: the suspend test has to arm the RTC (`rtcwake`), which
# needs root, and asking for a polkit password at 03:00 is asking nobody. The
# benchmark itself still runs as the user, because the GPU and compositor tests
# need the live Wayland session.
#
# WHY IT IS IDEMPOTENT: the timer fires once an hour through the night. Each
# run checks what is already on disk and does only what is missing, so a reboot
# in the middle costs the current measurement, not the night. kernel-bench
# writes its partial results after every test and `--resume` picks them up.
#
# ORDER MATTERS: the suspend cycle runs last, after the benchmark results are
# saved. Resuming from suspend hung this machine twice on 2026-09-16, and a
# hang must not take the measurements with it.
set -uo pipefail

USER_NAME=kevin
USER_UID=1000
HOME_DIR="/home/$USER_NAME"
STATE="$HOME_DIR/.local/state/kernel-bench"
LOG="$STATE/overnight.log"
BENCH="$HOME_DIR/.local/bin/kernel-bench"
KERNEL="$(uname -r)"
LABEL="${KERNEL_BENCH_LABEL:-unattended nightly run}"  # the kernel itself is recorded in the result
SLEEP_SECONDS=${KERNEL_BENCH_SLEEP_SECONDS:-1200}  # 20 min: short cycles drown in the awake seconds around them

log() {
  printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"
  logger -t kernel-bench-overnight -- "$*"
}

as_user() {
  runuser -u "$USER_NAME" -- env \
    XDG_RUNTIME_DIR="/run/user/$USER_UID" \
    WAYLAND_DISPLAY=wayland-1 \
    HYPRLAND_INSTANCE_SIGNATURE="${HYPR_SIG:-}" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$USER_UID/bus" \
    "$@"
}

hypr_signature() {
  local newest
  newest=$(ls -1t "/run/user/$USER_UID/hypr" 2>/dev/null | head -n 1)
  [[ -n $newest && -S /run/user/$USER_UID/hypr/$newest/.socket.sock ]] || return 1
  printf '%s' "$newest"
}

mkdir -p "$STATE"
chown "$USER_NAME:" "$STATE" 2>/dev/null
shopt -s nullglob

HYPR_SIG="$(hypr_signature)" || HYPR_SIG=""

ac_results=("$STATE/$KERNEL"-ac-*.json)
if ((${#ac_results[@]} == 0)); then
  if [[ -z $HYPR_SIG ]]; then
    # After a reboot the greeter may still be up: no session, no GPU numbers.
    log "no live Hyprland session; leaving the AC phase for the next timer"
    exit 0
  fi
  log "AC phase starting on $KERNEL"
  as_user "$BENCH" run --reps 3 --cargo-reps 2 --resume --label "$LABEL" >>"$LOG" 2>&1
  log "AC phase exited with status $?"
  ac_results=("$STATE/$KERNEL"-ac-*.json)
fi

if ((${#ac_results[@]} == 0)); then
  log "AC phase still incomplete; the next timer will resume it"
  exit 0
fi

suspend_results=("$STATE/$KERNEL"-suspend-*.json)
if ((${#suspend_results[@]})); then
  log "suspend cycle already recorded for $KERNEL; nothing left to do"
  exit 0
fi

battery_path=/sys/class/power_supply/BAT1
charge_before=$(cat "$battery_path/charge_now" 2>/dev/null || echo 0)
voltage=$(cat "$battery_path/voltage_now" 2>/dev/null || echo 0)
on_ac=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo 1)

log "suspend cycle: arming the RTC for ${SLEEP_SECONDS}s"
if ! rtcwake -m no -s "$SLEEP_SECONDS" >/dev/null 2>&1; then
  log "could not arm the RTC alarm; skipping the suspend cycle"
  exit 1
fi

started=$(date +%s)
systemctl suspend
# Wall clock, not sleep(1): CLOCK_MONOTONIC stops while the system is suspended,
# so `sleep 1200` kept running for another 20 minutes AFTER the machine woke up
# (seen 2026-09-17), and the charge sample taken at the end covered as much
# awake time as suspended time -- which is why that cycle reported 14.9 W.
# Polling the real clock ends the wait a few seconds after the RTC alarm.
while (( $(date +%s) < started + SLEEP_SECONDS + 5 )); do
  sleep 5
done
returned=$(date +%s)
# Read the charge before anything else: every awake second here is error.
charge_after=$(cat "$battery_path/charge_now" 2>/dev/null || echo 0)

# How long until the compositor answers again -- the part that hung twice today.
compositor_back=""
for ((i = 0; i < 120; i++)); do
  HYPR_SIG="$(hypr_signature)" || HYPR_SIG=""
  if [[ -n $HYPR_SIG ]] && as_user /usr/bin/hyprctl monitors >/dev/null 2>&1; then
    compositor_back=$(( $(date +%s) - returned ))
    break
  fi
  sleep 1
done

KERNEL="$KERNEL" STATE="$STATE" LABEL="$LABEL" \
SLEEP_SECONDS="$SLEEP_SECONDS" STARTED="$started" RETURNED="$returned" \
CHARGE_BEFORE="$charge_before" CHARGE_AFTER="$charge_after" VOLTAGE="$voltage" \
ON_AC="$on_ac" COMPOSITOR_BACK="$compositor_back" python3 - <<'PY'
import json, os, re, subprocess
from datetime import datetime, timezone

env = os.environ
state = env["STATE"]
kernel = env["KERNEL"]
seconds = int(env["SLEEP_SECONDS"])

journal = subprocess.run(
    ["journalctl", "-b", "-k", "-n", "400", "--no-pager", "-o", "short-precise"],
    capture_output=True, text=True, errors="replace").stdout
entry = exit_ = None
for line in journal.splitlines():
    if "PM: suspend entry" in line:
        entry = line.split()[2]
    elif "PM: suspend exit" in line:
        exit_ = line.split()[2]

# Power over the interval the kernel was actually out, not over the requested
# seconds: the charge samples bracket the awake tail as well, and dividing by
# the wrong denominator produced 22 W for a 120 s cycle on 2026-09-17. Even
# with the right denominator a short cycle is dominated by the awake seconds
# around it -- a trustworthy number needs a long suspend, which is what
# SLEEP_SECONDS is for.
def kernel_seconds(a, b):
    from datetime import datetime
    try:
        fmt = "%H:%M:%S.%f"
        return (datetime.strptime(b, fmt) - datetime.strptime(a, fmt)).total_seconds()
    except (ValueError, TypeError):
        return None

suspended_s = kernel_seconds(entry, exit_)
drain = None
before, after, volt = (int(env[k] or 0) for k in ("CHARGE_BEFORE", "CHARGE_AFTER", "VOLTAGE"))
if env["ON_AC"] != "1" and before and after and volt and after < before and suspended_s:
    drain = (before - after) / 1e6 * (volt / 1e6) / (suspended_s / 3600)

back = env["COMPOSITOR_BACK"]
results = {
    "suspend_cycle": {
        "requested_s": seconds,
        "wall_s": int(env["RETURNED"]) - int(env["STARTED"]),
        "kernel_suspend_entry": entry,
        "kernel_suspend_exit": exit_,
        "resumed": exit_ is not None,
        "compositor_back_after_s": int(back) if back else None,
        "compositor_hung": back == "",
        "suspended_s": suspended_s,
        "suspend_power_W": round(drain, 3) if drain else None,
        "power_trustworthy": bool(drain and suspended_s and suspended_s >= 900),
        "on_ac": env["ON_AC"] == "1",
        "note": "suspend power needs the charger unplugged; on AC it stays null",
    }
}
stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
path = os.path.join(state, f"{kernel}-suspend-{stamp}.json")
with open(path, "w") as f:
    json.dump({"label": env["LABEL"], "phase": "suspend",
               "environment": {"kernel": kernel,
                               "timestamp": datetime.now(timezone.utc).isoformat(timespec="seconds")},
               "results": results}, f, indent=2)
    f.write("\n")
print(path)
PY

chown -R "$USER_NAME:" "$STATE" 2>/dev/null
if [[ -n $compositor_back ]]; then
  log "suspend cycle done: compositor answered ${compositor_back}s after resume"
else
  log "suspend cycle done: THE COMPOSITOR NEVER ANSWERED after resume"
fi
