--- a/usr/bin/omarchy-update-available
+++ b/usr/bin/omarchy-update-available
@@ -4,6 +4,41 @@
 
 set -euo pipefail
 
+# Local change (kevin, 2026-09-15): serialize concurrent runs and cache the
+# result briefly. One bar per monitor means the bar widget starts one of these
+# per monitor at the same instant, and `checkupdates` shares a single temporary
+# database per user: the loser of that race prints "Cannot fetch updates" and
+# exits 1, which the widget reads as "no updates", so the icon is missing on
+# that monitor until the next six-hour check.
+if [[ -z ${OMARCHY_UPDATE_AVAILABLE_INNER:-} ]]; then
+  cache="${XDG_RUNTIME_DIR:-/tmp}/omarchy-update-available.$UID"
+  exec {lockfd}>"$cache.lock"
+  flock "$lockfd"
+  if [[ -f $cache.rc ]] && (($(date +%s) - $(stat -c %Y "$cache.rc") < 60)); then
+    [[ -f $cache.out ]] && cat "$cache.out"
+    exit "$(cat "$cache.rc")"
+  fi
+  rc=0
+  OMARCHY_UPDATE_AVAILABLE_INNER=1 "$0" "$@" >"$cache.out.new" || rc=$?
+  mv "$cache.out.new" "$cache.out"
+  printf '%s\n' "$rc" >"$cache.rc"
+  cat "$cache.out"
+  exit "$rc"
+fi
+
+# Local change (kevin, 2026-09-24): give checkupdates a database of its own.
+# The lock above only serializes copies of THIS script; it does nothing about
+# anyone else on the machine running checkupdates, and the default database
+# (${TMPDIR:-/tmp}/checkup-db-$UID) is shared by every caller, with each one
+# deleting that database's lock file as it exits. So a third-party updates
+# widget refreshing on its own schedule -- or a plain `checkupdates` in a
+# terminal -- makes this run fail with "Cannot fetch updates", print nothing,
+# and conclude Omarchy is up to date, hiding the icon until the next six-hour
+# check. Measured 2026-09-24: two concurrent runs on the shared database, one
+# returned 146 lines and the other exited 1 with no output; with a private
+# database both returned 146.
+export CHECKUPDATES_DB="${XDG_RUNTIME_DIR:-/tmp}/omarchy-checkup-db-$UID"
+
 updates=()
 
 if [[ $OMARCHY_PATH != "/usr/share/omarchy" ]]; then
