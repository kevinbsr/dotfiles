@@ -1565,11 +1565,27 @@
 
         CenterGestureArea { anchors.fill: parent }
 
-        HoverHandler {
-          onHoveredChanged: root.setCenterSectionHovered(hovered)
+        // Local change (kevin, 2026-09-21): the center reveal hover used to
+        // fill this item, which fills the whole bar --
+        // and since revealing widens the indicator section, it can shift
+        // where this content sits, un-hovering and re-hovering in a loop
+        // that never settles on its own. Limit it to the span of the center
+        // modules, so a width change caused by the indicators can no longer
+        // move this area's edge under a stationary pointer.
+        Item {
+          readonly property Item first: centerRoot.hasAnchor ? centerBefore : centerPlain
+          readonly property Item last: centerRoot.hasAnchor ? centerAfter : centerPlain
+          x: Math.min(first.x, centerAnchorModule.visible ? centerAnchorModule.x : first.x)
+          width: Math.max(last.x + last.width, centerAnchorModule.visible ? centerAnchorModule.x + centerAnchorModule.width : 0) - x
+          height: parent.height
+
+          HoverHandler {
+            onHoveredChanged: root.setCenterSectionHovered(hovered)
+          }
         }
 
         ModuleList {
+          id: centerPlain
           visible: !centerRoot.hasAnchor
           entries: centerRoot.entries
           region: "center"
