--- a/usr/bin/omarchy-hyprland-window-close-all	2026-11-15 04:32:09.723810784 -0300
+++ b/usr/bin/omarchy-hyprland-window-close-all	2026-11-15 04:32:09.736124539 -0300
@@ -15,6 +15,29 @@
   fi
 fi
 
+# Local change (kevin, 2026-09-15; rebased for omarchy 4.5): quit
+# Chromium-based browsers as a whole before closing windows. Closed one window
+# at a time, the browser records each close as the user's and its session keeps
+# only the last window. SIGTERM is Chromium's clean quit: exit_type SessionEnded
+# and every window restored on the next start, in ~0.4 s. The wait is capped at
+# 1.5 s, inside the 2 s omarchy-system gives this whole script.
+browser_pids=$(jq -r '.[].pid' <<<"$clients" | sort -u | while read -r pid; do
+  case $(basename "$(readlink "/proc/$pid/exe" 2>/dev/null)") in
+    brave | chrome | chromium | msedge | vivaldi-bin | helium | opera) ;;
+    *) continue ;;
+  esac
+  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q -- '--type=' || echo "$pid"
+done)
+if [[ -n $browser_pids ]]; then
+  kill -TERM $browser_pids 2>/dev/null
+  for _ in {1..15}; do
+    alive=0
+    for pid in $browser_pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
+    ((alive)) || break
+    sleep 0.1
+  done
+fi
+
 jq -r ".[].address" <<<"$clients" | \
   while read -r addr; do
     hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
