+  function screenHasBar(screen) {
+    if (!screen) return false
+    var name = String(screen.name || "")
+    var model = String(screen.model || "")
+    for (var i = 0; i < hiddenScreens.length; i++) {
+      var h = hiddenScreens[i]
+      if (h && (h === name || model.indexOf(h) !== -1)) return false
+    }
+    return true
+  }
